{
  "name": "@jev/core",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "jev-core — 共通判定レイヤー（回答層・判定層・ログ）",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "jev-golden": "./dist/bin/jev-golden.js",
    "jev-judge": "./dist/bin/jev-judge.js",
    "jev-observe": "./dist/bin/jev-observe.js",
    "jev-review": "./dist/bin/jev-review.js",
    "jev-stop": "./dist/bin/jev-stop.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.test.json",
    "test": "npm run typecheck && vitest run"
  },
  "dependencies": {
    "@typesafe-ai/sdk": "^0.6.0",
    "ts-morph": "^28.0.0"
  }
}
